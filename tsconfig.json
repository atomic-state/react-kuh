{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2020",
    "strict": false,
    "lib": ["es6", "dom", "es2019", "ES2023"],
    "allowJs": false,
    "jsx": "react",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "declaration": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
